page {
  /* 颜色 */
  --bg: #FBF6EE;
  --wall: #F3E8D8;
  --floor: #E7D3B8;
  --ink: #3F3A36;
  /* 文档 8.9：正文/提示文字需 ≥4.5:1（#6F685F 在 --bg / --card 上分别为 5.11 / 5.41） */
  --muted: #6F685F;
  --ink-faint: #C4B9AC;
  --accent: #D98E73;
  /* 按钮底色：白字在 #D98E73 上只有 2.6:1，改用加深一档的 #A85C42（4.91:1，文档 8.9） */
  --accent-strong: #A85C42;
  /* 强调文字：在 --accent-soft 上 5.47:1、在 --card 上 8.15:1（文档 8.9；#8A5A45 只有 3.83:1） */
  --accent-ink: #6E4433;
  --accent-soft: #F4C9B8;
  --card: #FFFDF9;
  --danger: #C25B4E;
  --success: #7A9B76;
  --sunny: #F2CC8F;
  --cloudy: #B8C0CC;
  --rainy: #7A9CC6;
  --thunder: #6C6A8A;

  /* 圆角 */
  --radius-sm: 12rpx;
  --radius-md: 20rpx;
  --radius-lg: 32rpx;

  /* 间距 */
  --space-xs: 8rpx;
  --space-sm: 16rpx;
  --space-md: 24rpx;
  --space-lg: 32rpx;
  --space-xl: 48rpx;

  /* 字号 */
  --font-xs: 22rpx;
  --font-sm: 24rpx;
  --font-md: 28rpx;
  --font-lg: 40rpx;
  --font-xl: 56rpx;
}
