<view class="home-page phase-{{phase}}">

  <!-- 自定义导航 -->
  <view class="nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-title">小怡怡安</view>
  </view>

  <!-- 抱抱横幅（文档 10.5「顶部横幅」）：只在 TA 的待处理抱抱时出现；
       我发出/已回应/已过期由底部按钮矩阵 + 心形动画表达（文档 9.4）。
       放在导航与场景之间占位，避免压住墙历等热区（文档 9.2）。 -->
  <view class="hug-slot" wx:if="{{home && home.couple && hugIncoming}}">
    <hug-banner incoming="{{hugIncoming}}" bind:respond="onHugRespond" />
  </view>

  <!-- 加载中 / 加载失败的房间轮廓 -->
  <view class="scene skeleton-scene" wx:if="{{!home && (loading || error)}}">
    <view class="sk-block sk-window"></view>
    <view class="sk-block sk-calendar"></view>
    <view class="sk-block sk-frame"></view>
    <view class="sk-block sk-sofa"></view>
    <view class="sk-block sk-fridge"></view>
    <view class="sk-block sk-door"></view>
    <view class="state-overlay">
      <view class="state-text" wx:if="{{loading}}">正在开门…</view>
      <block wx:else>
        <view class="state-text">{{error}}</view>
        <button class="btn-primary retry-btn" bindtap="onRetry">再试一次</button>
      </block>
    </view>
  </view>

  <!-- 小屋 -->
  <view class="scene" wx:if="{{home}}">
    <!-- 窗 -->
    <view class="window">
      <view class="window-glass">
        <view class="moon" wx:if="{{phase === 'night'}}"></view>
        <view class="sun" wx:if="{{phase === 'day' || phase === 'morning'}}"></view>
        <view class="star star-1" wx:if="{{phase === 'night'}}"></view>
        <view class="star star-2" wx:if="{{phase === 'night'}}"></view>
      </view>
      <view class="window-sill"></view>
    </view>

    <!-- 墙历 -->
    <view class="calendar" bindtap="onTapCalendar" aria-label="我们的日子">
      <view class="calendar-top">我们的日子</view>
      <view class="calendar-days" wx:if="{{home.couple}}">{{daysText}}</view>
      <view class="calendar-days calendar-days-empty" wx:else>从今天开始</view>
    </view>

    <!-- 相框 -->
    <view class="frame" bindtap="onTapProfile" aria-label="我的">
      <image class="frame-avatar" src="{{myAvatar}}" mode="aspectFill" />
    </view>

    <!-- 落地灯（日记，文档 9.10：我写了今天灯亮，TA 写了未解锁旁边小光点） -->
    <view
      class="lamp {{lampDim ? 'dim' : ''}}"
      bindtap="onTapLamp"
      aria-label="日记"
    >
      <view class="lamp-glow"></view>
      <view class="lamp-shade"></view>
      <view class="lamp-pole"></view>
      <view class="lamp-base"></view>
      <view class="lamp-dot" wx:if="{{lampDot}}"></view>
    </view>

    <!-- 地毯 -->
    <view class="rug"></view>

    <!-- 沙发 + 两个人 -->
    <view class="sofa">
      <view class="sofa-back"></view>
      <view class="sofa-arm sofa-arm-left"></view>
      <view class="sofa-arm sofa-arm-right"></view>
      <view class="sofa-seat"></view>
      <view class="people">
        <view class="person" aria-label="我的心情">
          <avatar-bubble
            user="{{myUser}}"
            mood="{{moodMine}}"
            size="md"
            bind:tap="onTapMyAvatar"
          />
          <view class="person-name">{{myName}}</view>
        </view>
        <view class="person" wx:if="{{home.couple}}" aria-label="TA 的心情">
          <avatar-bubble
            user="{{partnerUser}}"
            mood="{{moodPartner}}"
            size="md"
            hug-badge="{{hugIncoming ? true : false}}"
            bind:tap="onTapPartnerAvatar"
          />
          <view class="person-name">{{partnerName}}</view>
        </view>
        <view class="empty-seat" wx:else bindtap="onTapBind" aria-label="邀请 TA 住进来">
          <view class="empty-cushion"></view>
          <view class="empty-text">屋里还缺一个人</view>
        </view>
      </view>
    </view>

    <!-- 冰箱（愿望进度，文档 9.10 / 10.8） -->
    <view class="fridge" bindtap="onTapFridge" aria-label="愿望清单">
      <view class="fridge-door">
        <view class="fridge-handle"></view>
        <view class="fridge-note"></view>
        <view class="fridge-progress" wx:if="{{wishTotal > 0}}">{{wishDone}}/{{wishTotal}}</view>
      </view>
      <view class="fridge-bottom"></view>
    </view>

    <!-- 桌子便签（愿望预览，文档 9.10） -->
    <view class="table" bindtap="onTapTableNote" aria-label="愿望">
      <view class="table-note">
        <text class="table-note-text">{{wishPreviewTitle || '下次见面想做的事'}}</text>
      </view>
      <view class="table-top"></view>
      <view class="table-leg table-leg--left"></view>
      <view class="table-leg table-leg--right"></view>
    </view>

    <!-- 门（报平安，文档 9.10：对方今天报平安门灯暖） -->
    <view class="door {{doorLit ? 'door--lit' : ''}}" bindtap="onTapDoor" aria-label="报平安">
      <view class="door-panel">
        <view class="door-knob"></view>
      </view>
      <view class="door-label">{{safetyLabel}}</view>
    </view>

    <!-- 门垫信封：邀请状态 -->
    <view
      class="envelope {{home.bind.state}}"
      wx:if="{{!home.couple && home.bind.state !== 'unbound'}}"
      bindtap="onTapBind"
      aria-label="有人在等你"
    >
      <view class="envelope-body"></view>
      <view class="envelope-flap"></view>
      <image
        class="envelope-avatar"
        wx:if="{{home.bind.pending && home.bind.pending.other && home.bind.pending.other.avatarFileID}}"
        src="{{home.bind.pending.other.avatarFileID}}"
        mode="aspectFill"
        aria-label="等你确认的 TA"
      ></image>
      <view class="envelope-reddot" wx:if="{{home.bind.state === 'applied_by_partner'}}"></view>
    </view>

  </view>

  <!-- 底部动作 -->
  <view class="action-bar" wx:if="{{home}}">
    <block wx:if="{{home.bind.state === 'unbound'}}">
      <view class="action-hint">小屋还空着一半</view>
      <button class="btn-primary action-btn" bindtap="onTapBind">邀请 TA 住进来</button>
    </block>
    <block wx:elif="{{home.bind.state !== 'bound'}}">
      <view class="action-hint">{{bindHint}}</view>
      <button class="btn-primary action-btn" bindtap="onTapBind">去看看</button>
    </block>
    <block wx:else>
      <view class="action-hint">{{hugHint}}</view>
      <view class="hug-btn-wrap">
        <view class="hug-heart-float" wx:if="{{hugCelebrate}}">♥</view>
        <button
          class="btn-primary action-btn"
          bindtap="onTapHug"
          disabled="{{hugButtonDisabled || hugSending}}"
        >
          {{hugSending ? '抱抱中…' : hugButtonText}}
        </button>
      </view>
    </block>
  </view>

  <!-- 我们的日子浮层 -->
  <view class="sheet-mask" wx:if="{{showDaysSheet}}" bindtap="onCloseDaysSheet">
    <view class="sheet" catchtap="noop">
      <view class="sheet-handle"></view>
      <view class="sheet-title">我们的日子</view>
      <view class="sheet-days">{{daysText}}</view>
      <view class="sheet-row">
        <text class="sheet-label">开始于</text>
        <picker
          mode="date"
          value="{{startDateSelect}}"
          start="2000-01-01"
          end="{{maxStartDate}}"
          disabled="{{startDateSaving}}"
          bindchange="onStartDateChange"
        >
          <view class="sheet-value sheet-editable">
            {{startDateText}}
            <text class="sheet-edit">{{startDateSaving ? '保存中…' : '改'}}</text>
          </view>
        </picker>
      </view>
      <view class="sheet-row">
        <text class="sheet-label">下一个纪念日</text>
        <text class="sheet-value">{{anniversaryText}}</text>
      </view>
      <view class="sheet-tip">点「开始于」右边的「改」可以重新选日子</view>
      <view class="sheet-close" bindtap="onCloseDaysSheet">知道啦</view>
    </view>
  </view>

  <!-- 对方心情详情：只读，备注只在这里出现（文档 9.5） -->
  <view class="sheet-mask" wx:if="{{partnerMoodSheet}}" bindtap="onClosePartnerMood">
    <view class="sheet" catchtap="noop">
      <view class="sheet-handle"></view>
      <view class="sheet-title">{{partnerName}} 今天</view>
      <view class="pm-head">
        <avatar-bubble user="{{partnerUser}}" show-mood="{{false}}" size="lg" />
        <view class="pm-info">
          <block wx:if="{{partnerMood}}">
            <view class="pm-chip pm-chip--{{partnerMood.mood}}">{{partnerMood.emoji}} {{partnerMood.label}}</view>
            <view class="pm-time">{{partnerMood.timeText}} 记下的</view>
          </block>
          <view wx:else class="pm-empty">TA 今天还没说心情</view>
        </view>
      </view>
      <view class="pm-note" wx:if="{{partnerMood}}">
        <text wx:if="{{partnerMood.note}}">{{partnerMood.note}}</text>
        <text wx:else class="pm-note-empty">TA 今天没写备注</text>
      </view>
      <view class="sheet-close" bindtap="onClosePartnerMood">知道啦</view>
    </view>
  </view>

  <!-- 心情打卡弹层 -->
  <mood-picker
    show="{{moodPickerShow}}"
    value="{{moodMine}}"
    saving="{{moodSaving}}"
    bind:select="onMoodSelect"
    bind:close="onCloseMoodPicker"
  />

</view>
