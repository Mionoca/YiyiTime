<view class="home dk-page dk-page--tab {{cardEnter ? 'is-enter' : ''}}">

  <!-- 静默刷新失败：吸顶横幅，保留已加载卡片（文档 9.12 / 12.9） -->
  <view class="refresh-bar" wx:if="{{home && refreshError}}" aria-role="alert" aria-label="{{refreshError}}">
    <text class="refresh-bar__text">{{refreshError}}</text>
    <view class="refresh-bar__btn" bindtap="onRetryRefresh" aria-role="button" aria-label="重试加载首页">再试一次</view>
  </view>

  <!-- 首屏：三张虚线骨架卡，不白屏（文档 9.12） -->
  <block wx:if="{{!home && loading}}">
    <view class="dk-skeleton card-gap">
      <view class="dk-skeleton__bar dk-skeleton__bar--lg"></view>
      <view class="dk-skeleton__bar"></view>
      <view class="dk-skeleton__bar"></view>
    </view>
    <view class="dk-skeleton card-gap">
      <view class="dk-skeleton__bar"></view>
      <view class="dk-skeleton__bar"></view>
    </view>
    <view class="dk-skeleton">
      <view class="dk-skeleton__bar"></view>
    </view>
  </block>

  <!-- 首屏失败：整页错误 + 重试（文档 9.12） -->
  <view class="dk-card error-card" wx:if="{{!home && !loading}}">
    <text class="dk-title">{{error}}</text>
    <text class="dk-sub error-sub">检查一下网络，再敲敲门</text>
    <button class="btn-primary error-btn" bindtap="onRetry">再试一次</button>
  </view>

  <block wx:if="{{home}}">

    <!-- 解绑提示条（M9 / 文档 9.2）：细条，不参与卡片旋转；点了去「我的」处理 -->
    <view
      class="unbind-bar"
      wx:if="{{unbindNotice}}"
      bindtap="onTapUnbindNotice"
      aria-role="button"
      aria-label="{{unbindNoticeText}}"
    >
      <text class="unbind-bar__text">{{unbindNoticeText}}</text>
      <text class="unbind-bar__btn">去看看 ›</text>
    </view>

    <!-- 0.6 账本申请提示条（M13 / 文档 9.2 / 7.19）：TA 申请看我的账本且待处理时出现；
         与解绑条同构的细条，不参与卡片旋转；点了去「记账本」处理 -->
    <view
      class="ledger-bar"
      wx:if="{{ledgerNotice}}"
      bindtap="onTapLedgerNotice"
      aria-role="button"
      aria-label="TA 想看看你的账本，去处理"
    >
      <text class="ledger-bar__text">{{ledgerNoticeText}}</text>
      <text class="ledger-bar__btn">去看看 ›</text>
    </view>

    <!-- 未绑定 / 邀请中：只留一张邀请卡，其他卡片进去也是空态（文档 9.12） -->
    <view class="dk-card invite-card dk-card--tilt-l" wx:if="{{!home.couple}}">
      <view class="dk-tape"></view>
      <text class="dk-label">还差一个人</text>
      <text class="dk-title invite-title">{{bindTitle}}</text>
      <text class="dk-sub">{{bindSub}}</text>
      <button class="btn-primary btn-solid invite-btn" bindtap="onTapBind">{{bindActionText}}</button>
      <text class="invite-tip">绑好之后，这里会出现你们的日子、纪念日和心情</text>
    </view>

    <!-- 1 纪念日堆叠卡（文档 9.4）：在一起 + 自定义纪念日，Z 轴切换 -->
    <view class="stack-slot card-gap" wx:if="{{home.couple}}">
      <view class="dk-tape"></view>
      <anniversary-stack
        cards="{{cards}}"
        current="{{cardIndex}}"
        bind:change="onCardChange"
        bind:edit="onCardEdit"
        bind:manage="onManageAnniversary"
      />
    </view>

    <!-- 2 心情卡（文档 9.5）：自己那行可点开打卡，TA 那行只读 -->
    <view class="dk-card mood-card card-gap" wx:if="{{home.couple}}">
      <view class="card-head">
        <text class="dk-label">今天的心情</text>
        <view class="dk-link mood-link" bindtap="onTapMoodHistory" aria-role="button" aria-label="看心情记录">记录 ›</view>
      </view>

      <view class="mood-row">
        <avatar-bubble user="{{myUser}}" mood="{{moodMine}}" size="sm" bind:tap="onTapMyAvatar" />
        <view class="mood-info">
          <text class="mood-name">我</text>
          <text class="mood-desc {{moodMine ? '' : 'mood-desc--empty'}}">{{moodMineText}}</text>
        </view>
        <text class="mood-cta">{{moodMine ? '改' : '记一笔'}}</text>
      </view>

      <view class="dk-divider"></view>

      <view class="mood-row">
        <avatar-bubble user="{{partnerUser}}" mood="{{moodPartner}}" size="sm" bind:tap="onTapPartnerAvatar" />
        <view class="mood-info">
          <text class="mood-name">{{partnerName}}</text>
          <text class="mood-desc {{moodPartner ? '' : 'mood-desc--empty'}}">{{moodPartnerText}}</text>
        </view>
      </view>
    </view>

    <!-- 4 四个入口（文档 9.2）：动词短语 + 一行状态，不做物件隐喻 -->
    <view class="grid" wx:if="{{home.couple}}">
      <view class="dk-card grid__item" bindtap="onTapDiary" aria-role="button" aria-label="写今天的日记">
        <text class="grid__icon">✎</text>
        <text class="grid__title">写日记</text>
        <text class="grid__sub">{{diarySub}}</text>
      </view>
      <view class="dk-card grid__item" bindtap="onTapWish" aria-role="button" aria-label="愿望清单">
        <text class="grid__icon">★</text>
        <text class="grid__title">愿望清单</text>
        <text class="grid__sub">{{wishSub}}</text>
      </view>
      <!-- M14（17.4）：报平安下线，这一格改为「一起变好」；待认领用角标提示，不单独成点 -->
      <view class="dk-card grid__item grid__item--growth" bindtap="onTapGrowth" aria-role="button" aria-label="一起变好{{growthAwaiting ? '，有事等你认领' : ''}}">
        <text class="grid__icon">✦</text>
        <text class="grid__title">一起变好</text>
        <text class="grid__sub">{{growthSub || '起草第一件一起做的事'}}</text>
        <view wx:if="{{growthAwaiting}}" class="grid__badge" aria-hidden="true">!</view>
      </view>
      <view class="dk-card grid__item" bindtap="onTapMoodHistory" aria-role="button" aria-label="心情记录">
        <text class="grid__icon">☀</text>
        <text class="grid__title">心情记录</text>
        <text class="grid__sub">按天翻看两人的心情</text>
      </view>
    </view>

  </block>

  <!-- 我们的日子浮层 -->
  <view class="sheet-mask" wx:if="{{showDaysSheet}}" bindtap="onCloseDaysSheet">
    <view class="sheet" catchtap="noop">
      <view class="sheet-title">我们的日子</view>
      <view class="sheet-days">{{daysText}}</view>
      <view class="sheet-row">
        <text class="sheet-label">开始于</text>
        <picker
          mode="date"
          value="{{startDateSelect}}"
          start="2000-01-01"
          end="{{maxStartDate}}"
          disabled="{{startDateSaving}}"
          bindchange="onStartDateChange"
        >
          <view class="sheet-value sheet-editable">
            {{startDateText || '选一天'}}
            <text class="sheet-edit">{{startDateSaving ? '保存中…' : '改'}}</text>
          </view>
        </picker>
      </view>
      <view class="sheet-row">
        <text class="sheet-label">下一个纪念日</text>
        <text class="sheet-value">{{anniversaryText || '还没有'}}</text>
      </view>
      <view class="sheet-tip">点「开始于」右边的「改」可以重新选日子</view>
      <view class="sheet-close" bindtap="onCloseDaysSheet" aria-role="button" aria-label="关闭">知道啦</view>
    </view>
  </view>

  <!-- 对方心情详情：只读，备注只在这里出现（文档 9.5） -->
  <view class="sheet-mask" wx:if="{{partnerMoodSheet}}" bindtap="onClosePartnerMood">
    <view class="sheet" catchtap="noop">
      <view class="sheet-title">{{partnerName}} 今天</view>
      <view class="pm-head">
        <avatar-bubble user="{{partnerUser}}" show-mood="{{false}}" size="lg" />
        <view class="pm-info">
          <block wx:if="{{partnerMood}}">
            <view class="pm-chip pm-chip--{{partnerMood.mood}}">{{partnerMood.emoji}} {{partnerMood.label}}</view>
            <view class="pm-time">{{partnerMood.timeText}} 记下的</view>
          </block>
          <view wx:else class="pm-empty">TA 今天还没说心情</view>
        </view>
      </view>
      <view class="pm-note" wx:if="{{partnerMood}}">
        <text wx:if="{{partnerMood.note}}">{{partnerMood.note}}</text>
        <text wx:else class="pm-note-empty">TA 今天没写备注</text>
      </view>
      <view class="sheet-close" bindtap="onClosePartnerMood" aria-role="button" aria-label="关闭">知道啦</view>
    </view>
  </view>

  <!-- 心情打卡弹层 -->
  <mood-picker
    show="{{moodPickerShow}}"
    value="{{moodMine}}"
    saving="{{moodSaving}}"
    above-tab-bar="{{true}}"
    bind:select="onMoodSelect"
    bind:close="onCloseMoodPicker"
  />

  <!-- 隐私授权（文档 9.6 / 13.8）：只在微信要求授权时出现，低版本基础库交给微信原生弹窗 -->
  <privacy-guard id="privacyGuard" />

</view>
