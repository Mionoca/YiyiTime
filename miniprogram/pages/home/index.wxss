/*
 * 首页：卡片式仪表盘（文档 9.2 / 8.7）。
 * 视觉全部来自 app.wxss 的 dk-* 公共类，这里只写布局与少数局部尺寸。
 */

.home {
  min-height: 100vh;
  /* tab 页底部留出 tabBar + 安全区（文档 9.9），改写自 app.wxss 的 dk-page 默认值 */
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  background-color: var(--bg);
}

/* 卡片间距：24rpx（文档 9.2） */
.card-gap {
  margin-bottom: 24rpx;
}

/* ── 静默刷新失败的吸顶横幅（文档 9.12 / 12.9）──────────────── */
.refresh-bar {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding: 12rpx 12rpx 12rpx 24rpx;
  background-color: var(--card);
  border: 3rpx dashed var(--danger);
  border-radius: var(--radius-md);
  box-shadow: 8rpx 8rpx 0 var(--accent-soft);
}

.refresh-bar__text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: var(--danger);
}

/* 失败态唯一恢复入口：热区不能小于 88rpx（文档 8.9） */
.refresh-bar__btn {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  min-width: 160rpx;
  min-height: 88rpx;
  padding: 0 16rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--accent-ink);
  border-bottom: 2rpx dashed var(--accent-ink);
}

/* 解绑提示条（M9 / 文档 9.2）：细条，不用卡片样式，避免抢日子卡的视觉位置 */
.unbind-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding: 8rpx 8rpx 8rpx 24rpx;
  background-color: var(--card);
  border: 2rpx dashed var(--danger);
  border-radius: var(--radius-md);
}

.unbind-bar__text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: var(--danger);
}

.unbind-bar__btn {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  min-width: 160rpx;
  min-height: 88rpx;
  padding: 0 16rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--accent-ink);
}

/* ── 首屏失败 ───────────────────────────────────────────────── */.error-card {
  margin-top: 48rpx;
  padding: 48rpx 32rpx;
  text-align: center;
}

.error-sub {
  display: block;
  margin-top: 12rpx;
}

.error-btn {
  margin-top: 32rpx;
}

/* ── 邀请卡（未绑定 / 邀请中）──────────────────────────────── */
.invite-card {
  padding-top: 40rpx;
}

.invite-title {
  display: block;
  margin-top: 12rpx;
  font-size: 40rpx;
}

.invite-btn {
  margin-top: 28rpx;
}

.invite-tip {
  display: block;
  margin-top: 20rpx;
  font-size: 22rpx;
  color: var(--muted);
}

/* ── 日子卡 ─────────────────────────────────────────────────── */
.days-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.days-link {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--accent-ink);
  border-bottom: 2rpx dashed var(--accent-ink);
}

.days-num {
  display: block;
  margin-top: 16rpx;
}

.days-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.days-anniv {
  display: inline-block;
  margin-top: 16rpx;
  padding: 6rpx 16rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--accent-ink);
  background-color: var(--accent-soft);
  border: 2rpx dashed var(--accent-ink);
  border-radius: var(--radius-sm);
}

/* ── 抱抱卡 ─────────────────────────────────────────────────── */
.hug-head {
  display: flex;
  flex-direction: column;
  margin-bottom: 24rpx;
}

.hug-hint {
  margin-top: 8rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--ink);
}

.hug-btn-wrap {
  position: relative;
}

.hug-btn {
  width: 100%;
}

/* 心形上浮 1400ms：只动 transform / opacity（文档 9.7），JS 1440ms 后摘 class */
.hug-heart-float {
  position: absolute;
  top: -52rpx;
  left: 50%;
  margin-left: -24rpx;
  font-size: 44rpx;
  line-height: 1;
  color: var(--marker-red);
  pointer-events: none;
  animation: hug-float 1400ms ease-out;
}

@keyframes hug-float {
  0% {
    opacity: 0;
    transform: translateY(24rpx) scale(0.8);
  }
  30% {
    opacity: 1;
    transform: translateY(-8rpx) scale(1.1);
  }
  100% {
    opacity: 0;
    transform: translateY(-96rpx) scale(1);
  }
}

/* ── 心情卡 ─────────────────────────────────────────────────── */
.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.mood-link {
  min-height: 88rpx;
}

.mood-row {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}

.mood-info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.mood-name {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--ink);
}

.mood-desc {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 没打卡：浅色会被当成可忽略，用 muted + 斜体，靠虚线圈表达「还没说」（文档 9.5 / 8.9） */
.mood-desc--empty {
  color: var(--muted);
  font-style: italic;
}

.mood-cta {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 8rpx 18rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--accent-ink);
  border: 2rpx dashed var(--accent-ink);
  border-radius: var(--radius-sm);
}

/* ── 四个入口 ───────────────────────────────────────────────── */
.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.grid__item {
  display: flex;
  flex-direction: column;
  width: calc(50% - 12rpx);
  min-height: 152rpx;
  margin-bottom: 24rpx;
  padding: 24rpx;
}

.grid__icon {
  font-size: 34rpx;
  line-height: 1.2;
  color: var(--ink);
}

.grid__title {
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 800;
  color: var(--ink);
}

.grid__sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 1.45;
  color: var(--muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ── 浮层（我们的日子 / TA 的心情）───────────────────────────── */
.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 60;
  display: flex;
  align-items: flex-end;
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background-color: rgba(44, 44, 44, 0.35);
}

.sheet {
  width: 100%;
  max-height: 80vh;
  overflow-y: auto;
  padding: 32rpx;
  background-color: var(--card);
  border: 3rpx dashed var(--line);
  border-radius: var(--radius-lg);
  box-shadow: 10rpx 10rpx 0 var(--marker-yellow);
  animation: sheet-up 200ms linear;
}

@keyframes sheet-up {
  0% {
    opacity: 0;
    transform: translateY(40rpx);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--ink);
}

.sheet-days {
  margin-top: 12rpx;
  font-size: 56rpx;
  font-weight: 800;
  color: var(--ink);
  transform: rotate(-2deg);
}

.sheet-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  border-bottom: 2rpx dashed var(--ink-faint);
}

.sheet-label {
  font-size: 24rpx;
  color: var(--muted);
}

.sheet-value {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--ink);
}

.sheet-editable {
  display: flex;
  align-items: center;
}

.sheet-edit {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: var(--accent-ink);
  border-bottom: 2rpx dashed var(--accent-ink);
}

.sheet-tip {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.sheet-close {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  margin-top: 24rpx;
  font-size: 28rpx;
  font-weight: 800;
  color: var(--card);
  background-color: var(--accent-strong);
  border-radius: var(--radius-md);
}

.pm-head {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
}

.pm-info {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.pm-chip {
  display: inline-block;
  padding: 6rpx 16rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--ink);
  background-color: var(--wall);
  border: 2rpx dashed var(--line);
  border-radius: var(--radius-sm);
}

.pm-time {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.pm-empty {
  font-size: 26rpx;
  color: var(--muted);
}

.pm-note {
  margin-top: 24rpx;
  padding: 24rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--ink);
  background-color: var(--wall);
  border: 2rpx dashed var(--line);
  border-radius: var(--radius-sm);
}

.pm-note-empty {
  color: var(--ink-faint);
}

/* ── 卡片入场：一次性 class（文档 9.7）───────────────────────── */
.home.is-enter .dk-card {
  animation: card-in 300ms linear;
}

@keyframes card-in {
  0% {
    opacity: 0;
    transform: translateY(16rpx);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 旋转的卡片入场回到自己的角度，避免动画把 -1° 抹平后跳一下 */
.home.is-enter .dk-card--tilt-l {
  animation-name: card-in-left;
}

.home.is-enter .dk-card--tilt-r {
  animation-name: card-in-right;
}

@keyframes card-in-left {
  0% {
    opacity: 0;
    transform: translateY(16rpx) rotate(0deg);
  }
  100% {
    opacity: 1;
    transform: translateY(0) rotate(-1deg);
  }
}

@keyframes card-in-right {
  0% {
    opacity: 0;
    transform: translateY(16rpx) rotate(0deg);
  }
  100% {
    opacity: 1;
    transform: translateY(0) rotate(1deg);
  }
}

/* ── 小屏（320×568）：收内边距与天数，四宫格仍两列（文档 9.9）── */
@media (max-height: 640px) {
  .days-num {
    font-size: 48rpx;
  }

  .dk-card {
    padding: 24rpx;
  }

  .grid__item {
    min-height: 136rpx;
    padding: 20rpx;
  }
}

@media (prefers-reduced-motion: reduce) {
  .hug-heart-float,
  .sheet,
  .home.is-enter .dk-card {
    animation: none;
  }
}
