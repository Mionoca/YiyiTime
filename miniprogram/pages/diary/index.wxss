.page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));
  background: var(--bg, #FBF6EE);
}

/* ---------- 顶部编辑器 ---------- */
.editor {
  position: sticky;
  top: 0;
  z-index: 10;
  margin-bottom: 24rpx;
  padding: 24rpx;
  border-radius: var(--radius-lg, 32rpx);
  background: var(--card, #FFFDF9);
  box-shadow: 0 8rpx 32rpx rgba(63, 58, 54, 0.08);
}

.editor__input {
  width: 100%;
  min-height: 168rpx;
  padding: 20rpx;
  border-radius: var(--radius-md, 20rpx);
  background: var(--bg, #FBF6EE);
  font-size: var(--font-md, 28rpx);
  line-height: 1.7;
  color: var(--ink, #3F3A36);
}

.editor__placeholder {
  color: var(--muted, #6F685F);
}

.editor__bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 16rpx;
}

.editor__count {
  font-size: var(--font-xs, 22rpx);
  color: var(--muted, #6F685F);
}

.editor__save {
  padding: 14rpx 40rpx;
  border-radius: 999rpx;
  background: var(--accent-strong, #A85C42);
  color: #FFFFFF;
  font-size: var(--font-sm, 24rpx);
}

.editor__save--disabled {
  opacity: 0.45;
}

/* ---------- 状态 ---------- */
.hint {
  padding: 32rpx 0;
  text-align: center;
  font-size: var(--font-sm, 24rpx);
  color: var(--muted, #8C837A);
}

.hint--faint {
  color: var(--muted, #6F685F);
}

.state {
  padding: 120rpx 48rpx;
  text-align: center;
}

.state__text {
  margin-bottom: 40rpx;
  font-size: var(--font-md, 28rpx);
  color: var(--muted, #8C837A);
}

.state__btn {
  display: inline-flex;
  height: 80rpx;
  padding: 0 56rpx;
}

.empty {
  padding: 96rpx 48rpx;
  text-align: center;
}

.empty__icon {
  font-size: 64rpx;
}

.empty__text {
  margin-top: 16rpx;
  font-size: var(--font-md, 28rpx);
  color: var(--muted, #8C837A);
}
