/* 台灯下的日记：涂鸦风（文档 8.7） */
.page {
  min-height: 100vh;
  /* tab 页底部留出 tabBar + 安全区（文档 8.2 / 9.9） */
  padding: 24rpx 24rpx calc(140rpx + env(safe-area-inset-bottom));
  background-color: var(--bg);
}

/* ---------- 顶部编辑器 ---------- */
.editor {
  position: sticky;
  top: 0;
  z-index: 10;
  margin-bottom: 24rpx;
  padding: 24rpx;
  background-color: var(--card);
  border: 3rpx dashed var(--line);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
}

.editor__input {
  width: 100%;
  min-height: 168rpx;
  padding: 20rpx;
  background-color: var(--wall);
  border: 2rpx dashed var(--ink-faint);
  border-radius: var(--radius-sm);
  font-size: var(--font-md);
  line-height: 1.7;
  color: var(--ink);
}

.editor__placeholder {
  color: var(--muted);
}

.editor__bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 16rpx;
}

.editor__count {
  font-size: var(--font-xs);
  color: var(--muted);
}

/* 保存：墨黑实心 + 虚线边 + 马克笔红硬阴影 */
.editor__save {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 40rpx;
  background-color: var(--accent-strong);
  color: var(--card);
  border: 3rpx dashed var(--line);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-btn);
  font-size: var(--font-sm);
  font-weight: 800;
  letter-spacing: 2rpx;
  transition: transform 150ms linear;
}

.editor__save:active {
  transform: translate(3rpx, 3rpx);
  box-shadow: none;
}

.editor__save--disabled {
  opacity: 0.45;
  box-shadow: none;
}

/* ---------- 状态 ---------- */
.hint {
  padding: 32rpx 0;
  text-align: center;
  font-size: var(--font-sm);
  color: var(--muted);
}

.hint--faint {
  color: var(--muted);
}

/* 文档 12.9：列表失败保留内容 + 底部可点重试 */
.hint--error {
  display: inline-block;
  min-height: 88rpx;
  line-height: 88rpx;
  color: var(--accent-ink);
  border-bottom: 2rpx dashed var(--accent-ink);
}

.state {
  padding: 120rpx 48rpx;
  text-align: center;
}

.state__text {
  margin-bottom: 40rpx;
  font-size: var(--font-md);
  color: var(--muted);
}

.state__btn {
  display: inline-flex;
  min-height: 88rpx;
  padding: 0 56rpx;
}

.empty {
  padding: 96rpx 48rpx;
  text-align: center;
}

.empty__icon {
  font-size: 64rpx;
}

.empty__text {
  margin-top: 16rpx;
  font-size: var(--font-md);
  color: var(--muted);
}
