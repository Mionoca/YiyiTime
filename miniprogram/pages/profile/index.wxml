<view class="profile-page">

  <view class="loading" wx:if="{{loading && !home}}">正在开门…</view>

  <view class="error-state" wx:if="{{!loading && !home}}">
    <view class="error-text">{{error || '小屋暂时打不开'}}</view>
    <button class="btn-primary error-retry" bindtap="onRetry">再试一次</button>
  </view>

  <block wx:if="{{home}}">
    <!-- 资料卡 -->
    <view class="card profile-card">
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image class="avatar-img" src="{{avatarPreview}}" mode="aspectFill" />
      </button>
      <view class="profile-main">
        <input
          class="nickname-input"
          type="nickname"
          value="{{nickname}}"
          maxlength="{{nicknameMax}}"
          placeholder="你的昵称"
          placeholder-class="input-placeholder"
          bindinput="onNicknameInput"
        />
        <view class="bind-state">{{bindStateText}}</view>
      </view>
      <view class="save-btn" bindtap="onSaveNickname" aria-disabled="{{saving}}">{{saving ? '保存中…' : '保存'}}</view>
    </view>

    <!-- 我们的日子 -->
    <view class="card days-card" wx:if="{{bound}}">
      <view class="days-head">
        <view class="days-title">我们的日子</view>
        <view class="days-number">{{daysText}}</view>
      </view>
      <view class="row">
        <text class="row-label">开始于</text>
        <text class="row-value">{{startDateText}}</text>
      </view>
      <view class="row">
        <text class="row-label">下一个纪念日</text>
        <text class="row-value">{{anniversaryText}}</text>
      </view>
      <picker
        mode="date"
        value="{{startDateSelect}}"
        start="2000-01-01"
        end="{{maxStartDate}}"
        disabled="{{startDateSaving}}"
        bindchange="onStartDateChange"
      >
        <view class="row-link">{{startDateSaving ? '保存中…' : '修改开始日期 →'}}</view>
      </picker>
    </view>

    <!-- 邀请 -->
    <view class="card invite-card" wx:if="{{!bound}}">
      <view class="invite-title">屋里还缺一个人</view>
      <view class="invite-sub">邀请 TA 一起住进来，日子从你们选的那天算起</view>
      <button class="btn-primary" bindtap="onTapBind">去邀请 TA</button>
    </view>

    <!-- 更多（文档 8.3.6：P1 占位项禁用；振动反馈是可用功能，文档 8.9） -->
    <view class="card list-card">
      <view class="list-item list-item--disabled">
        <text>每日提醒（即将上线）</text>
      </view>
      <view class="list-item" bindtap="onOpenMood" aria-role="button" aria-label="心情记录">
        <text>心情记录</text>
        <text class="list-arrow">›</text>
      </view>
      <view class="list-item" bindtap="onOpenLedger" aria-role="button" aria-label="记账本">
        <text>记账本</text>
        <text class="list-arrow">›</text>
      </view>
      <!-- M9 解绑：已绑定才出现；三态文案由服务端 unbind.requestedByMe 决定（文档 8.3.6） -->
      <view
        class="list-item"
        wx:if="{{bound}}"
        bindtap="onTapUnbind"
        aria-role="button"
        aria-label="{{unbindText}}"
      >
        <text class="{{unbindStatus === 'none' ? '' : 'list-danger'}}">{{unbindText}}</text>
        <text class="list-arrow">›</text>
      </view>
      <view class="list-item">
        <text>振动反馈</text>
        <switch class="list-switch" checked="{{hapticsEnabled}}" color="#A85C42" bindchange="onToggleHaptics" />
      </view>
      <view class="list-item" bindtap="onOpenPrivacy">
        <text>隐私保护指引</text>
        <text class="list-arrow">›</text>
      </view>
      <view class="list-item" bindtap="onOpenDataPrivacy">
        <text>数据与隐私</text>
        <text class="list-arrow">›</text>
      </view>
      <view class="list-item">
        <text>关于小怡怡安</text>
        <text class="list-version">{{appVersion}}</text>
      </view>
    </view>

    <!-- 文档 11.6：数据与隐私说明（体验版阶段以此为准，正式上线前补完整协议） -->
    <bottom-sheet show="{{privacySheet}}" title="数据与隐私" bind:close="onCloseDataPrivacy">
      <view class="privacy-section" wx:for="{{privacySections}}" wx:key="title">
        <view class="privacy-section__title">{{item.title}}</view>
        <view class="privacy-section__text">{{item.text}}</view>
      </view>
      <view class="privacy-sheet__footer">{{privacyFooter}}</view>
      <view class="privacy-sheet__close" bindtap="onCloseDataPrivacy" aria-role="button">知道啦</view>
    </bottom-sheet>

    <view class="footer">小怡怡安 · 只属于两个人的小屋</view>
  </block>

  <!-- 隐私授权（文档 9.6 / 13.8）：微信要求授权时出现 -->
  <privacy-guard />

</view>
