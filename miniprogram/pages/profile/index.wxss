/* 我的：涂鸦风（文档 8.7） */
.profile-page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(140rpx + env(safe-area-inset-bottom));
  background-color: var(--bg);
}

.loading {
  padding-top: 240rpx;
  text-align: center;
  color: var(--muted);
  font-size: var(--font-md);
}

.error-state {
  padding-top: 240rpx;
  text-align: center;
}

.error-text {
  color: var(--muted);
  font-size: var(--font-md);
  margin-bottom: 32rpx;
}

.error-retry {
  display: inline-flex;
  min-height: 88rpx;
  padding: 0 48rpx;
}

/* ---------- 资料卡 ---------- */
.profile-card {
  display: flex;
  align-items: center;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.avatar-btn {
  width: 120rpx;
  height: 120rpx;
  padding: 0;
  border-radius: 50%;
  background-color: var(--wall);
  border: 2rpx dashed var(--line);
  position: relative;
  overflow: hidden;
  flex-shrink: 0;
}

.avatar-btn::after {
  border: none;
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  /* 圆形头像必须 aspectFill 裁成方形；偏上对齐让人脸（自拍多在中上部）不被切掉（17.7） */
  object-position: center 30%;
}

/* 换头像提示：与 bind 页同款，避免头像看着像「只能看」的静态图 */
.avatar-tip {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 32rpx;
  line-height: 32rpx;
  font-size: 18rpx;
  color: var(--card);
  background-color: rgba(44, 44, 44, 0.55);
}

.profile-main {
  flex: 1;
  margin-left: 24rpx;
  min-width: 0;
}

.nickname-input {
  height: 72rpx;
  padding: 0 16rpx;
  font-size: 34rpx;
  font-weight: 800;
  color: var(--ink);
  background-color: var(--wall);
  border: 2rpx dashed var(--ink-faint);
  border-radius: var(--radius-sm);
}

.input-placeholder {
  color: var(--muted);
  font-weight: 400;
}

.bind-state {
  margin-top: 8rpx;
  font-size: var(--font-sm);
  color: var(--muted);
}

/* 保存：小号实心按钮，热区仍 ≥88rpx（8.9） */
.save-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 128rpx;
  min-height: 88rpx;
  margin-left: 16rpx;
  padding: 0 24rpx;
  background-color: var(--card);
  border: 3rpx dashed var(--line);
  border-radius: var(--radius-md);
  box-shadow: 6rpx 6rpx 0 var(--marker-yellow);
  color: var(--ink);
  font-size: var(--font-sm);
  font-weight: 800;
}

.save-btn:active {
  transform: translate(3rpx, 3rpx);
  box-shadow: none;
}

/* ---------- 我们的日子 ---------- */
.days-card {
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.days-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding-bottom: 16rpx;
  margin-bottom: 16rpx;
  border-bottom: 2rpx dashed var(--ink-faint);
}

.days-title {
  font-size: var(--font-sm);
  font-weight: 700;
  letter-spacing: 0.12em;
  color: var(--muted);
}

.days-number {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--ink);
  transform: rotate(-2deg);
}

.row {
  display: flex;
  justify-content: space-between;
  min-height: 72rpx;
  padding: 16rpx 0;
}

.row-label {
  color: var(--muted);
  font-size: var(--font-md);
}

.row-value {
  color: var(--ink);
  font-size: var(--font-md);
  font-weight: 600;
  text-align: right;
}

.row-link {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  min-height: 88rpx;
  margin-top: 8rpx;
  border-top: 2rpx dashed var(--ink-faint);
  color: var(--accent-ink);
  font-size: var(--font-sm);
  font-weight: 700;
}

/* ---------- 邀请 ---------- */
.invite-card {
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
}

.invite-title {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--ink);
}

.invite-sub {
  margin: 12rpx 0 32rpx;
  color: var(--muted);
  font-size: var(--font-md);
}

/* ---------- 更多 ---------- */
.list-card {
  padding: 0 32rpx;
  margin-bottom: 40rpx;
}

.list-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 104rpx;
  font-size: var(--font-md);
  color: var(--ink);
  border-bottom: 2rpx dashed var(--ink-faint);
}

.list-item:last-child {
  border-bottom: none;
}

.list-arrow {
  color: var(--ink-faint);
  font-size: 36rpx;
}

/* 文档 8.3.6：P1 占位项统一禁用态。仍用 --muted（灰但要读得清），靠无箭头表达不可点 */
.list-item--disabled {
  color: var(--muted);
}

/* 每日提醒（M10 / 文档 8.3.6）：第一行开关，第二行时间；换行后仍按 list-item 的分隔线 */
.list-item--stack {
  display: block;
  padding: 24rpx 0;
}

.list-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 72rpx;
}

.list-main {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.list-sub {
  color: var(--muted);
  font-size: var(--font-sm);
  line-height: 1.5;
}

.list-time {
  display: flex;
  align-items: center;
  min-height: 72rpx;
  color: var(--muted);
  font-size: var(--font-sm);
}

/* 待处理的解绑（文档 8.3.6）：用 --danger，在纸底上仍 ≥4.5:1 */
.list-danger {
  color: var(--danger);
  font-weight: 700;
}

.list-version {
  color: var(--muted);
  font-size: var(--font-sm);
}

/* 文档 11.6：数据与隐私说明弹层 */
.privacy-section + .privacy-section {
  border-top: 2rpx dashed var(--ink-faint);
}

.privacy-section__title {
  padding-top: 20rpx;
  font-size: var(--font-md);
  font-weight: 800;
  color: var(--ink);
}

.privacy-section__text {
  margin-top: 8rpx;
  padding-bottom: 20rpx;
  font-size: var(--font-sm);
  line-height: 1.6;
  color: var(--muted);
}

.privacy-sheet__footer {
  padding-top: 24rpx;
  font-size: var(--font-sm);
  line-height: 1.6;
  color: var(--muted);
}

/* 实心主按钮：墨黑底 + 奶白字（12.0:1），88rpx 满足热区 */
.privacy-sheet__close {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  margin-top: 32rpx;
  background-color: var(--accent-strong);
  border: 3rpx dashed var(--line);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-btn);
  font-size: var(--font-md);
  font-weight: 800;
  color: var(--card);
}

/* 振动反馈开关：不缩放，保留原生 switch 的命中区域 */
.list-switch {
  flex-shrink: 0;
}

.footer {
  text-align: center;
  font-size: var(--font-sm);
  color: var(--muted);
}

/* ---------- 危险操作（M14 / 17.8）：注销入口 ---------- */
/* 与上方说明文字用一条虚线隔开，红字只用在「注销账号」标签上，避免整块刺眼 */
.danger-zone {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 2rpx dashed var(--ink-faint);
}

.danger-zone__title {
  margin-bottom: 12rpx;
  font-size: var(--font-xs);
  color: var(--muted);
}

.danger-zone__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  padding: 8rpx 4rpx;
}

.danger-zone__main {
  flex: 1;
  min-width: 0;
}

.danger-zone__label {
  display: block;
  font-size: var(--font-md);
  font-weight: 700;
  color: var(--danger);
}

.danger-zone__desc {
  display: block;
  margin-top: 4rpx;
  font-size: var(--font-xs);
  line-height: 1.5;
  color: var(--muted);
}

.danger-zone__arrow {
  flex: none;
  margin-left: 12rpx;
  font-size: 32rpx;
  color: var(--ink-faint);
}
