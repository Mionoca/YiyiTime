/* 住进来：涂鸦风（文档 8.7） */
.bind-page {
  min-height: 100vh;
  padding: 48rpx 40rpx 96rpx;
  background-color: var(--bg);
}

.center-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 240rpx;
}

.loading-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: var(--marker-red);
  margin-bottom: 24rpx;
  animation: breathe 1.2s linear infinite;
}

@keyframes breathe {
  0% {
    opacity: 0.3;
    transform: scale(0.8);
  }
  100% {
    opacity: 1;
    transform: scale(1.2);
  }
}

.state-text {
  color: var(--muted);
  font-size: var(--font-md);
}

.retry-btn {
  margin-top: 48rpx;
  min-width: 320rpx;
  min-height: 88rpx;
}

.section {
  animation: fade-up 240ms linear;
}

@keyframes fade-up {
  0% {
    opacity: 0;
    transform: translateY(16rpx);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

.section-title {
  font-size: var(--font-lg);
  font-weight: 800;
  color: var(--ink);
  margin-bottom: 12rpx;
  transform: rotate(-2deg);
}

.section-sub {
  font-size: var(--font-md);
  color: var(--muted);
  margin-bottom: 40rpx;
}

/* 头像：圆形保留（人像惯例），描边改虚线 */
.avatar-btn {
  width: 200rpx;
  height: 200rpx;
  padding: 0;
  margin: 16rpx auto 40rpx;
  border-radius: 50%;
  background-color: var(--wall);
  border: 3rpx dashed var(--line);
  position: relative;
  overflow: hidden;
}

.avatar-btn::after {
  border: none;
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-tip {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 44rpx;
  line-height: 44rpx;
  font-size: 20rpx;
  color: var(--card);
  background-color: rgba(44, 44, 44, 0.55);
}

/* Scribble Input：虚线边 + 牛皮纸底（8.7） */
.input {
  height: 96rpx;
  padding: 0 24rpx;
  margin-bottom: 32rpx;
  background-color: var(--wall);
  border: 2rpx dashed var(--line);
  border-radius: var(--radius-sm);
  font-size: 30rpx;
  color: var(--ink);
}

.input-placeholder {
  color: var(--muted);
}

.code-input {
  font-size: 44rpx;
  letter-spacing: 16rpx;
  text-align: center;
}

.main-btn {
  margin-top: 16rpx;
}

.hint {
  margin-top: 24rpx;
  text-align: center;
  font-size: var(--font-sm);
  color: var(--muted);
}

.picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 96rpx;
  padding: 0 24rpx;
  margin-bottom: 32rpx;
  background-color: var(--wall);
  border: 2rpx dashed var(--line);
  border-radius: var(--radius-sm);
}

.picker-label {
  font-size: var(--font-md);
  color: var(--muted);
}

.picker-value {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
}

.link-row {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  margin-top: 16rpx;
  font-size: var(--font-md);
  font-weight: 700;
  color: var(--accent-ink);
}

.creator-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx;
  margin-bottom: 40rpx;
}

.creator-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background-color: var(--wall);
  border: 3rpx dashed var(--line);
}

.creator-name {
  margin-top: 24rpx;
  font-size: var(--font-lg);
  font-weight: 800;
  color: var(--ink);
}

.creator-desc {
  margin-top: 8rpx;
  font-size: var(--font-sm);
  color: var(--muted);
}

.creator-date {
  margin-top: 24rpx;
  padding: 8rpx 24rpx;
  background-color: var(--accent-soft);
  border: 2rpx dashed var(--accent-ink);
  border-radius: var(--radius-sm);
  color: var(--accent-ink);
  font-size: var(--font-sm);
  font-weight: 700;
}

.code-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 56rpx 32rpx;
  margin-bottom: 24rpx;
}

.code-value {
  font-size: 80rpx;
  font-weight: 800;
  letter-spacing: 16rpx;
  color: var(--ink);
  transform: rotate(-2deg);
}

.code-expire {
  margin-top: 16rpx;
  font-size: var(--font-sm);
  color: var(--muted);
}

.btn-row {
  display: flex;
  margin-top: 8rpx;
}

.btn-row .btn-primary {
  min-height: 96rpx;
}

.btn-row .btn-primary:first-child {
  margin-right: 24rpx;
}

.flex1 {
  flex: 1;
}
