.bind-page {
  min-height: 100vh;
  padding: 48rpx 48rpx 96rpx;
  background: linear-gradient(180deg, #FBF6EE 0%, #F6EADB 100%);
}

.center-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 240rpx;
}

.loading-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: var(--accent);
  margin-bottom: 24rpx;
  animation: breathe 1.2s ease-in-out infinite;
}

@keyframes breathe {
  0%, 100% { opacity: 0.3; transform: scale(0.8); }
  50% { opacity: 1; transform: scale(1.2); }
}

.state-text {
  color: var(--muted);
  font-size: var(--font-md);
}

.retry-btn {
  margin-top: 48rpx;
  width: 320rpx;
}

.section {
  animation: fade-up 240ms ease-out;
}

@keyframes fade-up {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.section-title {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 12rpx;
}

.section-sub {
  font-size: var(--font-md);
  color: var(--muted);
  margin-bottom: 48rpx;
}

.avatar-btn {
  width: 200rpx;
  height: 200rpx;
  padding: 0;
  margin: 16rpx auto 48rpx;
  border-radius: 50%;
  background-color: var(--card);
  border: 4rpx solid var(--accent-soft);
  position: relative;
  overflow: hidden;
}

.avatar-btn::after {
  border: none;
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-tip {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 44rpx;
  line-height: 44rpx;
  font-size: 20rpx;
  color: #FFFFFF;
  background-color: rgba(63, 58, 54, 0.45);
}

.input {
  height: 96rpx;
  padding: 0 32rpx;
  margin-bottom: 32rpx;
  border-radius: var(--radius-md);
  background-color: var(--card);
  font-size: 30rpx;
  color: var(--ink);
}

.input-placeholder {
  color: #C4B9AC;
}

.code-input {
  font-size: 44rpx;
  letter-spacing: 16rpx;
  text-align: center;
}

.main-btn {
  margin-top: 16rpx;
}

.hint {
  margin-top: 24rpx;
  text-align: center;
  font-size: var(--font-sm);
  color: var(--muted);
}

.picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 96rpx;
  padding: 0 32rpx;
  margin-bottom: 32rpx;
  border-radius: var(--radius-md);
  background-color: var(--card);
}

.picker-label {
  font-size: var(--font-md);
  color: var(--muted);
}

.picker-value {
  font-size: 30rpx;
  color: var(--ink);
}

.link-row {
  margin-top: 32rpx;
  text-align: center;
  font-size: var(--font-md);
  color: var(--accent);
}

.creator-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx;
  margin-bottom: 48rpx;
}

.creator-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background-color: var(--wall);
  border: 4rpx solid var(--accent-soft);
}

.creator-name {
  margin-top: 24rpx;
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--ink);
}

.creator-desc {
  margin-top: 8rpx;
  font-size: var(--font-sm);
  color: var(--muted);
}

.creator-date {
  margin-top: 24rpx;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  background-color: var(--accent-soft);
  color: #8A5A45;
  font-size: var(--font-sm);
}

.code-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 56rpx 32rpx;
  margin-bottom: 24rpx;
}

.code-value {
  font-size: 80rpx;
  font-weight: 600;
  letter-spacing: 16rpx;
  color: var(--ink);
}

.code-expire {
  margin-top: 16rpx;
  font-size: var(--font-sm);
  color: var(--muted);
}

.btn-row {
  display: flex;
  margin-top: 8rpx;
}

.btn-row .btn-primary:first-child {
  margin-right: 24rpx;
}

.flex1 {
  flex: 1;
}
