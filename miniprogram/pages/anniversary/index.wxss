/* 纪念日管理（文档 8.3.9 / 8.7）：与愿望页同一套纸卡 + 虚线语言 */
.page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(140rpx + env(safe-area-inset-bottom));
  background-color: var(--bg);
}

.intro {
  padding: 8rpx 8rpx 24rpx;
}

.intro__title {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  color: var(--ink);
  transform: rotate(-1deg);
}

.intro__sub {
  display: block;
  margin-top: 8rpx;
  font-size: var(--font-sm);
  line-height: 1.6;
  color: var(--muted);
}

/* ---------- 添加按钮 ---------- */
.add {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 96rpx;
  margin: 8rpx 0;
  border: 3rpx dashed var(--line);
  border-radius: var(--radius-md);
  background-color: var(--card);
  box-shadow: var(--shadow-btn);
  font-size: var(--font-md);
  font-weight: 700;
  color: var(--ink);
}

.add:active {
  transform: translate(3rpx, 3rpx);
  box-shadow: none;
}

.add--disabled {
  opacity: 0.45;
  box-shadow: none;
  border-color: var(--ink-faint);
  color: var(--muted);
}

.add__plus {
  margin-right: 8rpx;
  font-size: 30rpx;
}

.limit-hint {
  padding: 8rpx 8rpx 16rpx;
  font-size: var(--font-xs);
  color: var(--danger);
  text-align: center;
}

/* ---------- 状态 ---------- */
.hint {
  padding: 32rpx 0;
  text-align: center;
  font-size: var(--font-sm);
  color: var(--muted);
}

.list-error {
  display: block;
  min-height: 88rpx;
  padding: 24rpx;
  text-align: center;
  font-size: var(--font-sm);
  color: var(--accent-ink);
  border: 2rpx dashed var(--accent-ink);
  border-radius: var(--radius-sm);
}

/* ---------- 列表 ---------- */
.list {
  margin-top: 16rpx;
}

.row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 24rpx 28rpx;
  background-color: var(--card);
  border: 3rpx dashed var(--line);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
}

.row__main {
  flex: 1;
  min-width: 0;
}

.row__title {
  display: block;
  font-size: var(--font-md);
  font-weight: 800;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row__sub {
  display: block;
  margin-top: 6rpx;
  font-size: var(--font-xs);
  color: var(--muted);
}

.row__right {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.row__days {
  font-size: var(--font-sm);
  font-weight: 700;
  color: var(--ink);
}

/* 「就是今天」是这一页唯一的强调：用马克笔黄底 + 墨字（8.7 / 9.6） */
.row__days.is-today {
  padding: 4rpx 12rpx;
  background-color: var(--marker-yellow);
  color: var(--ink);
  border-radius: var(--radius-sm);
}

/* 删除是破坏性操作：只留文字，不与整行点击抢注意力，但有 88rpx 热区 */
.row__del {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  margin-left: 8rpx;
  font-size: var(--font-xs);
  color: var(--danger);
  text-decoration: underline;
}

/* ---------- 表单 ---------- */
.form {
  padding: 8rpx 0 16rpx;
}

.field {
  margin-bottom: 24rpx;
}

.field__label {
  display: block;
  margin-bottom: 12rpx;
  font-size: var(--font-xs);
  font-weight: 700;
  letter-spacing: 0.08em;
  color: var(--muted);
}

.field__input {
  height: 96rpx;
  padding: 0 24rpx;
  background-color: var(--wall);
  border: 2rpx dashed var(--line);
  border-radius: var(--radius-sm);
  font-size: var(--font-md);
  color: var(--ink);
}

.field__picker {
  display: flex;
  align-items: center;
  height: 96rpx;
  padding: 0 24rpx;
  background-color: var(--wall);
  border: 2rpx dashed var(--line);
  border-radius: var(--radius-sm);
  font-size: var(--font-md);
  color: var(--ink);
}

.field__tip {
  display: block;
  margin-top: 12rpx;
  font-size: var(--font-xs);
  line-height: 1.6;
  color: var(--muted);
}

.form__save {
  width: 100%;
  min-height: 96rpx;
  line-height: 96rpx;
  margin-top: 8rpx;
}
