.page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));
  background: var(--bg, #FBF6EE);
}

/* ---------- 页头 ---------- */
.intro {
  padding: 8rpx 8rpx 28rpx;
}

.intro__title {
  font-size: var(--font-lg, 40rpx);
  line-height: 1.3;
  color: var(--ink, #3F3A36);
}

.intro__desc {
  margin-top: 8rpx;
  font-size: var(--font-sm, 24rpx);
  color: var(--muted, #6F685F);
}

/* ---------- 一天一张卡 ---------- */
.day {
  margin-bottom: 20rpx;
  padding: 24rpx;
  border-radius: var(--radius-lg, 32rpx);
  background: var(--card, #FFFDF9);
  box-shadow: 0 8rpx 32rpx rgba(63, 58, 54, 0.06);
}

.day__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid rgba(111, 104, 95, 0.12);
}

.day__label {
  font-size: var(--font-md, 28rpx);
  color: var(--accent-ink, #6E4433);
}

.day__date {
  font-size: var(--font-xs, 22rpx);
  color: var(--muted, #6F685F);
}

/* ---------- 一行一个人 ---------- */
.mood {
  padding: 18rpx 0;
}

.mood + .mood {
  border-top: 1rpx dashed rgba(111, 104, 95, 0.16);
}

.mood__head {
  display: flex;
  align-items: center;
}

.mood__who {
  width: 56rpx;
  flex: none;
  font-size: var(--font-xs, 22rpx);
  color: var(--muted, #6F685F);
}

.mood__emoji {
  flex: none;
  font-size: 34rpx;
  line-height: 1;
}

.mood__label {
  margin-left: 10rpx;
  font-size: var(--font-md, 28rpx);
  color: var(--ink, #3F3A36);
}

.mood__time {
  margin-left: auto;
  font-size: var(--font-xs, 22rpx);
  color: var(--muted, #6F685F);
}

.mood__note {
  margin-top: 10rpx;
  padding-left: 56rpx;
  font-size: var(--font-sm, 24rpx);
  line-height: 1.6;
  color: var(--ink, #3F3A36);
  word-break: break-all;
}

/* 没打卡：虚线气泡 + 「没说」，与首页未打卡气泡同一口径（9.5） */
.mood--empty .mood__emoji {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  border: 1rpx dashed var(--ink-faint, #C4B9AC);
  border-radius: 50%;
  font-size: var(--font-xs, 22rpx);
  color: var(--muted, #6F685F);
}

.mood--empty .mood__label {
  color: var(--muted, #6F685F);
}

/* ---------- 状态 ---------- */
.hint {
  padding: 32rpx 0;
  text-align: center;
  font-size: var(--font-sm, 24rpx);
  color: var(--muted, #6F685F);
}

.hint--faint {
  color: var(--muted, #6F685F);
}

/* 文档 12.9：列表失败保留内容 + 底部可点重试（#A85C42 文字在 #FBF6EE 上 4.57:1，达标） */
.hint--error {
  color: var(--accent-strong, #A85C42);
  text-decoration: underline;
}
