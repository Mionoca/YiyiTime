/* 心情记录：涂鸦风（文档 8.7） */
.page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(140rpx + env(safe-area-inset-bottom));
  background-color: var(--bg);
}

/* ---------- 页头 ---------- */
.intro {
  padding: 8rpx 8rpx 28rpx;
}

.intro__title {
  font-size: var(--font-lg);
  font-weight: 800;
  line-height: 1.3;
  color: var(--ink);
  transform: rotate(-2deg);
}

.intro__desc {
  margin-top: 8rpx;
  font-size: var(--font-sm);
  color: var(--muted);
}

/* ---------- 一天一张卡 ---------- */
.day {
  margin-bottom: 24rpx;
  padding: 24rpx;
  background-color: var(--card);
  border: 3rpx dashed var(--line);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
}

.day__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding-bottom: 12rpx;
  border-bottom: 2rpx dashed var(--ink-faint);
}

.day__label {
  font-size: var(--font-md);
  font-weight: 800;
  color: var(--accent-ink);
}

.day__date {
  font-size: var(--font-xs);
  color: var(--muted);
}

/* ---------- 一行一个人 ---------- */
.mood {
  padding: 18rpx 0;
}

.mood + .mood {
  border-top: 2rpx dashed var(--ink-faint);
}

.mood__head {
  display: flex;
  align-items: center;
}

.mood__who {
  width: 56rpx;
  flex: none;
  font-size: var(--font-xs);
  font-weight: 700;
  color: var(--muted);
}

.mood__emoji {
  flex: none;
  font-size: 34rpx;
  line-height: 1;
}

.mood__label {
  margin-left: 10rpx;
  font-size: var(--font-md);
  font-weight: 700;
  color: var(--ink);
}

.mood__time {
  margin-left: auto;
  font-size: var(--font-xs);
  color: var(--muted);
}

.mood__note {
  margin-top: 10rpx;
  padding-left: 56rpx;
  font-size: var(--font-sm);
  line-height: 1.6;
  color: var(--ink);
  word-break: break-all;
}

/* 没打卡：虚线圈 + 「没说」，与首页未打卡同一口径（9.5） */
.mood--empty .mood__emoji {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  border: 2rpx dashed var(--ink-faint);
  border-radius: 50%;
  font-size: var(--font-xs);
  color: var(--muted);
}

.mood--empty .mood__label {
  color: var(--muted);
  font-weight: 400;
}

/* ---------- 状态 ---------- */
.hint {
  padding: 32rpx 0;
  text-align: center;
  font-size: var(--font-sm);
  color: var(--muted);
}

.hint--faint {
  color: var(--muted);
}

/* 文档 12.9：列表失败保留内容 + 底部可点重试（--accent-ink 在纸上 7.7:1） */
.hint--error {
  display: inline-block;
  min-height: 88rpx;
  line-height: 88rpx;
  color: var(--accent-ink);
  border-bottom: 2rpx dashed var(--accent-ink);
}
