<view class="page">
  <!-- 顶部：报平安（文档 8.3.5 / 10.6） -->
  <view class="checkin">
    <view class="checkin__title">到家了吗</view>
    <view class="checkin__sub">按一下，让 TA 知道你平安</view>
    <view
      class="checkin__btn {{checking ? 'checkin__btn--busy' : ''}}"
      bindtap="onCheckin"
      aria-label="我到家了"
    >{{checking ? '记录中…' : '我到家了'}}</view>
    <input
      class="checkin__input"
      value="{{note}}"
      maxlength="{{noteMax}}"
      placeholder="加一句备注（可选）"
      placeholder-class="checkin__placeholder"
      bindinput="onNoteInput"
      aria-label="报平安备注"
    />
  </view>

  <view class="section-title">最近报平安</view>

  <view wx:if="{{loading}}" class="hint">正在看门口的灯…</view>

  <empty-state
    wx:elif="{{error}}"
    title="{{error}}"
    action-text="再试一次"
    bind:action="onRetry"
  />

  <block wx:else>
    <view class="timeline">
      <timeline-item
        wx:for="{{items}}"
        wx:key="checkinId"
        item="{{item}}"
        is-mine="{{item.openid === myOpenid}}"
      />
    </view>

    <empty-state
      wx:if="{{!items.length}}"
      icon="🏠"
      title="还没有人报平安，到了记得说一声"
    />

    <view wx:if="{{loadingMore}}" class="hint">正在翻页…</view>
    <view wx:elif="{{!nextCursor && items.length > 4}}" class="hint hint--faint">没有更多啦</view>
  </block>
</view>
