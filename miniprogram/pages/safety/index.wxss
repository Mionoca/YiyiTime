/* 我到家了：涂鸦风（文档 8.7） */
.page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));
  background-color: var(--bg);
}

/* ---------- 报平安 ---------- */
.checkin {
  padding: 32rpx;
  background-color: var(--card);
  border: 3rpx dashed var(--line);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
  text-align: center;
}

.checkin__title {
  font-size: var(--font-lg);
  font-weight: 800;
  color: var(--ink);
  transform: rotate(-2deg);
}

.checkin__sub {
  margin-top: 8rpx;
  font-size: var(--font-sm);
  color: var(--muted);
}

/* 主按钮：墨黑实心 + 虚线边 + 马克笔红硬阴影，不用渐变（8.7） */
.checkin__btn {
  margin: 32rpx 0 24rpx;
  padding: 36rpx 0;
  background-color: var(--accent-strong);
  border: 3rpx dashed var(--line);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-btn);
  color: var(--card);
  font-size: var(--font-lg);
  font-weight: 800;
  letter-spacing: 4rpx;
  transition: transform 150ms linear;
}

.checkin__btn:active {
  transform: translate(3rpx, 3rpx);
  box-shadow: none;
}

.checkin__btn--busy {
  opacity: 0.6;
  box-shadow: none;
}

.checkin__input {
  height: 88rpx;
  padding: 0 24rpx;
  background-color: var(--wall);
  border: 2rpx dashed var(--ink-faint);
  border-radius: var(--radius-sm);
  font-size: var(--font-sm);
  color: var(--ink);
  text-align: center;
}

.checkin__placeholder {
  color: var(--muted);
}

/* ---------- 时间线 ---------- */
.section-title {
  padding: 40rpx 8rpx 16rpx;
  font-size: var(--font-xs);
  font-weight: 700;
  letter-spacing: 0.12em;
  color: var(--muted);
}

/* ---------- 状态 ---------- */
.hint {
  padding: 32rpx 0;
  text-align: center;
  font-size: var(--font-sm);
  color: var(--muted);
}

.hint--faint {
  color: var(--muted);
}

.state {
  padding: 120rpx 48rpx;
  text-align: center;
}

.state__text {
  margin-bottom: 40rpx;
  font-size: var(--font-md);
  color: var(--muted);
}

.state__btn {
  display: inline-flex;
  min-height: 88rpx;
  padding: 0 56rpx;
}

.empty {
  padding: 96rpx 48rpx;
  text-align: center;
}

.empty__icon {
  font-size: 64rpx;
}

.empty__text {
  margin-top: 16rpx;
  font-size: var(--font-md);
  color: var(--muted);
}
