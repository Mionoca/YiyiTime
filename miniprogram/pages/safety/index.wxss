.page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));
  background: var(--bg, #FBF6EE);
}

/* ---------- 报平安按钮 ---------- */
.checkin {
  padding: 32rpx;
  border-radius: var(--radius-lg, 32rpx);
  background: var(--card, #FFFDF9);
  box-shadow: 0 8rpx 32rpx rgba(63, 58, 54, 0.08);
  text-align: center;
}

.checkin__title {
  font-size: var(--font-lg, 40rpx);
  font-weight: 600;
  color: var(--ink, #3F3A36);
}

.checkin__sub {
  margin-top: 8rpx;
  font-size: var(--font-sm, 24rpx);
  color: var(--muted, #8C837A);
}

.checkin__btn {
  margin: 32rpx 0 24rpx;
  padding: 36rpx 0;
  border-radius: var(--radius-md, 20rpx);
  background: linear-gradient(135deg, #E8A88D 0%, #D98E73 100%);
  color: #FFFFFF;
  font-size: var(--font-lg, 40rpx);
  font-weight: 600;
  letter-spacing: 4rpx;
  box-shadow: 0 12rpx 28rpx rgba(217, 142, 115, 0.32);
}

.checkin__btn--busy {
  opacity: 0.6;
}

.checkin__input {
  height: 80rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: var(--bg, #FBF6EE);
  font-size: var(--font-sm, 24rpx);
  color: var(--ink, #3F3A36);
  text-align: center;
}

.checkin__placeholder {
  color: var(--ink-faint, #C4B9AC);
}

/* ---------- 时间线 ---------- */
.section-title {
  padding: 40rpx 8rpx 16rpx;
  font-size: var(--font-sm, 24rpx);
  color: var(--muted, #8C837A);
  letter-spacing: 2rpx;
}

/* ---------- 状态 ---------- */
.hint {
  padding: 32rpx 0;
  text-align: center;
  font-size: var(--font-sm, 24rpx);
  color: var(--muted, #8C837A);
}

.hint--faint {
  color: var(--ink-faint, #C4B9AC);
}

.state {
  padding: 120rpx 48rpx;
  text-align: center;
}

.state__text {
  margin-bottom: 40rpx;
  font-size: var(--font-md, 28rpx);
  color: var(--muted, #8C837A);
}

.state__btn {
  display: inline-flex;
  height: 80rpx;
  padding: 0 56rpx;
}

.empty {
  padding: 96rpx 48rpx;
  text-align: center;
}

.empty__icon {
  font-size: 64rpx;
}

.empty__text {
  margin-top: 16rpx;
  font-size: var(--font-md, 28rpx);
  color: var(--muted, #8C837A);
}
