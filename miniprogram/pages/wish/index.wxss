/* 下次见面想做的事：涂鸦风（文档 8.7） */
.page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(140rpx + env(safe-area-inset-bottom));
  background-color: var(--bg);
}

/* ---------- 进度 ---------- */
.stats {
  padding: 28rpx 32rpx;
  background-color: var(--card);
  border: 3rpx dashed var(--line);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
}

.stats__top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.stats__title {
  font-size: var(--font-md);
  font-weight: 800;
  color: var(--ink);
}

.stats__num {
  font-size: var(--font-lg);
  font-weight: 800;
  color: var(--accent-ink);
  transform: rotate(-2deg);
}

/* 进度条：实心马克笔色 + 虚线边，不用渐变（8.7） */
.stats__bar {
  height: 20rpx;
  margin: 20rpx 0 12rpx;
  background-color: var(--wall);
  border: 2rpx dashed var(--line);
  border-radius: var(--radius-sm);
  overflow: hidden;
}

.stats__bar-in {
  width: 100%;
  height: 100%;
  background-color: var(--marker-teal);
  transform-origin: left center;
  transition: transform 300ms linear;
}

.stats__hint {
  font-size: var(--font-xs);
  color: var(--muted);
}

/* ---------- 新增按钮 ---------- */
.add {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 96rpx;
  margin: 24rpx 0 8rpx;
  border: 3rpx dashed var(--line);
  border-radius: var(--radius-md);
  background-color: var(--card);
  box-shadow: var(--shadow-btn);
  color: var(--ink);
  font-size: var(--font-md);
  font-weight: 800;
  transition: transform 150ms linear;
}

.add:active {
  transform: translate(3rpx, 3rpx);
  box-shadow: none;
}

.add--disabled {
  opacity: 0.45;
  box-shadow: none;
  border-color: var(--ink-faint);
  color: var(--muted);
}

.add__plus {
  margin-right: 8rpx;
  font-size: 30rpx;
}

.limit-hint {
  padding: 8rpx 8rpx 16rpx;
  font-size: var(--font-xs);
  color: var(--danger);
  text-align: center;
}

/* ---------- 状态 ---------- */
.hint {
  padding: 32rpx 0;
  text-align: center;
  font-size: var(--font-sm);
  color: var(--muted);
}

.state {
  padding: 120rpx 48rpx;
  text-align: center;
}

.state__text {
  margin-bottom: 40rpx;
  font-size: var(--font-md);
  color: var(--muted);
}

.state__btn {
  display: inline-flex;
  min-height: 88rpx;
  padding: 0 56rpx;
}

.empty {
  padding: 96rpx 48rpx;
  text-align: center;
}

.empty__icon {
  font-size: 64rpx;
}

.empty__text {
  margin-top: 16rpx;
  font-size: var(--font-md);
  color: var(--muted);
}

/* ---------- 弹层表单：便签输入（8.7 Scribble Input）---------- */
.form__input {
  height: 96rpx;
  padding: 0 24rpx;
  background-color: var(--wall);
  border: 2rpx dashed var(--line);
  border-radius: var(--radius-sm);
  font-size: var(--font-md);
  color: var(--ink);
}

.form__placeholder {
  color: var(--muted);
}

.form__textarea {
  width: 100%;
  min-height: 160rpx;
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  background-color: var(--wall);
  border: 2rpx dashed var(--line);
  border-radius: var(--radius-sm);
  font-size: var(--font-md);
  line-height: 1.6;
  color: var(--ink);
}

.form__count {
  padding: 8rpx 8rpx 0;
  text-align: right;
  font-size: var(--font-xs);
  color: var(--muted);
}

.form__actions {
  display: flex;
  align-items: center;
  margin-top: 32rpx;
}

/* 遮罩不可点是防误触，但必须留一个明确的取消出口 */
.form__cancel {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 176rpx;
  min-height: 96rpx;
  margin-right: 20rpx;
  background-color: transparent;
  border: 3rpx dashed var(--ink-faint);
  border-radius: var(--radius-md);
  color: var(--muted);
  font-size: 28rpx;
}

.form__save {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 96rpx;
  background-color: var(--accent-strong);
  border: 3rpx dashed var(--line);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-btn);
  color: var(--card);
  font-size: 30rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  transition: transform 150ms linear;
}

.form__save:active {
  transform: translate(3rpx, 3rpx);
  box-shadow: none;
}

.form__save--disabled {
  opacity: 0.5;
  box-shadow: none;
}
