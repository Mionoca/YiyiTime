@import "./styles/tokens.wxss";

page {
  background-color: var(--bg);
  color: var(--ink);
  font-size: 28rpx;
  line-height: 1.6;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
}

view,
text,
button,
input,
image {
  box-sizing: border-box;
}

button::after {
  border: none;
}

/* 通用：主按钮 / 次按钮 */
.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  padding: 0 48rpx;
  border-radius: 48rpx;
  /* 白字要压在 --accent-strong 上才够对比度（文档 8.9） */
  background-color: var(--accent-strong, #A85C42);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
}

.btn-primary.btn-ghost {
  background-color: transparent;
  border: 2rpx solid var(--accent-strong, #A85C42);
  /* --accent 本身在浅底上对比度不足，描边按钮文字用 --accent-ink（文档 8.9） */
  color: var(--accent-ink);
}

.btn-primary[disabled] {
  opacity: 0.5;
  color: #FFFFFF;
}

.card {
  background-color: var(--card);
  border-radius: var(--radius-lg);
  box-shadow: 0 8rpx 32rpx rgba(63, 58, 54, 0.08);
}
