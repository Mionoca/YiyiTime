/* 报平安时间线：涂鸦风（文档 8.7） */
.tl {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 0;
}

.tl--mine {
  flex-direction: row-reverse;
}

.tl__avatar {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  margin: 4rpx 16rpx;
  border-radius: 50%;
  border: 2rpx dashed var(--line);
  background-color: var(--wall);
}

.tl__main {
  max-width: 72%;
  min-width: 0;
}

.tl--mine .tl__main {
  text-align: right;
}

.tl__meta {
  display: flex;
  align-items: baseline;
  padding: 0 8rpx 6rpx;
  font-size: var(--font-xs);
  color: var(--muted);
}

.tl--mine .tl__meta {
  flex-direction: row-reverse;
}

.tl__name {
  color: var(--ink);
  font-size: var(--font-sm);
  font-weight: 700;
}

.tl__time {
  margin: 0 12rpx;
}

/* 气泡：虚线便签 + 硬阴影，不用灰色模糊 */
.tl__bubble {
  display: inline-block;
  padding: 18rpx 24rpx;
  background-color: var(--card);
  border: 2rpx dashed var(--line);
  border-radius: var(--radius-sm);
  box-shadow: 4rpx 4rpx 0 var(--marker-yellow);
  font-size: var(--font-md);
  color: var(--ink);
  line-height: 1.5;
  word-break: break-all;
  text-align: left;
}

.tl--mine .tl__bubble {
  background-color: var(--accent-soft);
  border-color: var(--accent-ink);
  color: var(--accent-ink);
  box-shadow: 4rpx 4rpx 0 var(--marker-red);
}

.tl__bubble--plain {
  font-style: italic;
}
