.wi {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
  padding: 26rpx 24rpx;
  border-radius: var(--radius-lg, 32rpx);
  background: var(--card, #FFFDF9);
  box-shadow: 0 8rpx 32rpx rgba(63, 58, 54, 0.06);
}

.wi--done {
  opacity: 0.72;
}

.wi--disabled {
  opacity: 0.6;
}

.wi__check-hit {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  margin: -18rpx 8rpx 0 -18rpx;
}

.wi__check {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  border: 3rpx solid var(--ink-faint, #C4B9AC);
  background: transparent;
}

.wi__check--done {
  border-color: var(--success, #7A9B76);
  background: var(--success, #7A9B76);
}

.wi__tick {
  color: #FFFFFF;
  font-size: 30rpx;
  line-height: 1;
}

.wi__check--bounce {
  animation: wi-bounce 300ms ease-out;
}

@keyframes wi-bounce {
  0% { transform: scale(0.9); }
  60% { transform: scale(1.1); }
  100% { transform: scale(1); }
}

.wi__body {
  flex: 1;
  min-width: 0;
}

.wi__title {
  font-size: var(--font-md, 28rpx);
  color: var(--ink, #3F3A36);
  line-height: 1.5;
  word-break: break-all;
}

.wi--done .wi__title {
  text-decoration: line-through;
  color: var(--muted, #8C837A);
}

.wi__note {
  margin-top: 8rpx;
  font-size: var(--font-sm, 24rpx);
  color: var(--muted, #8C837A);
  line-height: 1.5;
  word-break: break-all;
}

.wi__done {
  margin-top: 8rpx;
  font-size: var(--font-xs, 22rpx);
  color: var(--success, #7A9B76);
}

.wi__ops {
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  padding-left: 8rpx;
}

/* 文档 8.9：热区 ≥88rpx（文字保持 22rpx） */
.wi__op {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 88rpx;
  min-height: 88rpx;
  margin-top: -18rpx;
  padding: 0 4rpx;
  font-size: var(--font-xs, 22rpx);
  color: var(--accent, #D98E73);
}

.wi__op--danger {
  color: var(--danger, #C25B4E);
}
