/* 愿望条目：涂鸦便签（文档 8.7） */
.wi {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
  padding: 24rpx;
  background-color: var(--card);
  border: 3rpx dashed var(--line);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
}

.wi--done {
  opacity: 0.72;
}

.wi--disabled {
  opacity: 0.6;
}

/* 勾选热区 88rpx（8.9），圆圈本身小一些更像手绘方框 */
.wi__check-hit {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  margin: -18rpx 8rpx 0 -18rpx;
}

.wi__check {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  border-radius: var(--radius-sm);
  border: 3rpx dashed var(--line);
  background: transparent;
}

.wi__check--done {
  border: 3rpx dashed var(--success);
  background-color: var(--success);
}

.wi__tick {
  color: var(--card);
  font-size: 30rpx;
  line-height: 1;
}

.wi__check--bounce {
  animation: wi-bounce 300ms linear;
}

@keyframes wi-bounce {
  0% {
    transform: scale(0.9);
  }
  60% {
    transform: scale(1.1);
  }
  100% {
    transform: scale(1);
  }
}

.wi__body {
  flex: 1;
  min-width: 0;
}

.wi__title {
  font-size: var(--font-md);
  color: var(--ink);
  font-weight: 600;
  line-height: 1.5;
  word-break: break-all;
}

.wi--done .wi__title {
  text-decoration: line-through;
  color: var(--muted);
}

.wi__note {
  margin-top: 8rpx;
  font-size: var(--font-sm);
  color: var(--muted);
  line-height: 1.5;
  word-break: break-all;
}

.wi__done {
  margin-top: 8rpx;
  font-size: var(--font-xs);
  color: var(--success);
}

.wi__ops {
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  padding-left: 8rpx;
}

/* 文档 8.9：热区 ≥88rpx（文字保持 22rpx） */
.wi__op {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 88rpx;
  min-height: 88rpx;
  margin-top: -18rpx;
  padding: 0 4rpx;
  font-size: var(--font-xs);
  color: var(--accent-ink);
  text-decoration: underline;
}

.wi__op--danger {
  color: var(--danger);
}
