/* 底部弹层：涂鸦风（文档 8.7） */
.bs {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  /* 文档 9.8：页面级浮层在第 60 层 */
  z-index: 60;
}

.bs__mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background-color: rgba(44, 44, 44, 0.35);
}

.bs__sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 48rpx calc(48rpx + env(safe-area-inset-bottom));
  background-color: var(--card);
  /* 便签从下面抽出来：边框走虚线，顶部两角略收 */
  border-top: 3rpx dashed var(--line);
  border-left: 3rpx dashed var(--line);
  border-right: 3rpx dashed var(--line);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  animation: bs-up 240ms linear;
}

@keyframes bs-up {
  0% {
    transform: translateY(100%);
  }
  100% {
    transform: translateY(0);
  }
}

.bs__handle {
  width: 64rpx;
  height: 8rpx;
  margin: 0 auto 16rpx;
  background-color: var(--ink-faint);
  border-radius: 4rpx;
}

.bs__title {
  padding: 8rpx 0 16rpx;
  text-align: center;
  font-size: var(--font-lg);
  font-weight: 800;
  color: var(--ink);
}

.bs__body {
  max-height: 70vh;
  overflow-y: auto;
}
