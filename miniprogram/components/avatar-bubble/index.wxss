/* 头像 + 心情气泡：涂鸦风（文档 8.7 / 9.5） */
.avatar-bubble {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  max-width: 100%;
}

/* ---------- 心情气泡 ---------- */
.bubble {
  --bubble-bg: var(--card);
  --bubble-color: var(--ink);
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 64rpx;
  margin-bottom: 10rpx;
  padding: 6rpx 14rpx;
  border-radius: var(--radius-sm);
  background: var(--bubble-bg);
  border: 2rpx dashed var(--line);
  color: var(--bubble-color);
  /* 彩色硬阴影，不用灰色模糊（8.7） */
  box-shadow: 4rpx 4rpx 0 var(--marker-yellow);
  /* 气泡在头像右上方（文档 9.5），三角指向头像 */
  align-self: flex-end;
  margin-right: -10rpx;
}

/* 只在心情真的变化时由页面/组件加 class 触发一次淡入（文档 10.4） */
.bubble.is-pop {
  animation: bubble-in 200ms linear;
}

.bubble__icon {
  margin-right: 4rpx;
  font-size: 22rpx;
  line-height: 1;
}

.bubble__char {
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.1;
}

.bubble__tail {
  position: absolute;
  left: 25%;
  bottom: -8rpx;
  width: 0;
  height: 0;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  border-top: 8rpx solid var(--bubble-bg);
}

/* 四色只做淡底，文字用深色保证对比度（不只靠颜色，8.9） */
.bubble--sunny {
  --bubble-bg: #FFF3C4;
  --bubble-color: #4A3A00;
}

.bubble--cloudy {
  --bubble-bg: #EDF0F4;
  --bubble-color: #3C424C;
}

.bubble--rainy {
  --bubble-bg: #D9F5F2;
  --bubble-color: #1F4B48;
}

.bubble--thunder {
  --bubble-bg: #E6E4F0;
  --bubble-color: #33304A;
}

.bubble--empty {
  border: 2rpx dashed var(--ink-faint);
  background: var(--card);
  color: var(--muted);
  box-shadow: none;
}

.bubble--empty .bubble__tail {
  border-top-color: var(--card);
}

@keyframes bubble-in {
  0% {
    opacity: 0;
    transform: translateY(6rpx) scale(0.94);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

/* ---------- 头像 ---------- */
.avatar-wrap {
  position: relative;
  display: flex;
}

/* 圆形保留（人像惯例），描边改虚线 + 硬阴影，像贴上去的照片 */
.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 3rpx dashed var(--line);
  background: var(--wall);
  box-shadow: 4rpx 4rpx 0 var(--marker-yellow);
  /* 与 profile 头像一致：偏上对齐，避免竖构图把脸裁在中间偏下（17.7） */
  object-position: center 30%;
}

.avatar-bubble--sm .avatar {
  width: 72rpx;
  height: 72rpx;
  border-width: 2rpx;
  box-shadow: 3rpx 3rpx 0 var(--marker-yellow);
}

.avatar-bubble--lg .avatar {
  width: 132rpx;
  height: 132rpx;
  border-width: 4rpx;
}

