/* 心情打卡弹层：涂鸦风（文档 8.7 / 9.5） */
.mp-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 60;
  display: flex;
  align-items: flex-end;
  background-color: rgba(44, 44, 44, 0.35);
}

.mp-sheet {
  width: 100%;
  padding: 24rpx 40rpx calc(48rpx + env(safe-area-inset-bottom));
  background-color: var(--card);
  border-top: 3rpx dashed var(--line);
  border-left: 3rpx dashed var(--line);
  border-right: 3rpx dashed var(--line);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  color: var(--ink);
  animation: mp-up 240ms linear;
}

@keyframes mp-up {
  0% {
    transform: translateY(100%);
  }
  100% {
    transform: translateY(0);
  }
}

/* tab 页（今天 / 记账本 / 我的）里弹层要让开 custom-tab-bar 的高度：
   只加 padding 不动定位——弹层仍贴底，内容整体上移，tab 栏在留白区可见可点（17.6） */
.mp-sheet--above {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom) + 100rpx);
  max-height: calc(70vh - 100rpx - env(safe-area-inset-bottom));
  overflow-y: auto;
}

.mp-handle {
  width: 64rpx;
  height: 8rpx;
  margin: 0 auto 24rpx;
  background-color: var(--ink-faint);
  border-radius: 4rpx;
}

.mp-title {
  font-size: 34rpx;
  font-weight: 800;
}

.mp-sub {
  margin-top: 6rpx;
  font-size: var(--font-sm);
  color: var(--muted);
}

.mp-options {
  display: flex;
  justify-content: space-between;
  margin: 32rpx 0 8rpx;
}

/* 四个心情：奶白便签 + 虚线边，选中加马克笔黄硬阴影 */
.mp-option {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 140rpx;
  height: 150rpx;
  border-radius: var(--radius-md);
  border: 2rpx dashed var(--ink-faint);
  background-color: var(--card);
  transition: transform 160ms linear;
}

.mp-option.is-active {
  border: 3rpx dashed var(--line);
  background-color: var(--marker-yellow);
  box-shadow: 5rpx 5rpx 0 var(--ink);
  transform: translateY(-4rpx);
}

.mp-option__icon {
  font-size: 44rpx;
  line-height: 1.2;
}

.mp-option__label {
  margin-top: 8rpx;
  font-size: var(--font-sm);
  font-weight: 700;
  color: var(--ink);
}

.mp-note-wrap {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  background-color: var(--wall);
  border: 2rpx dashed var(--line);
  border-radius: var(--radius-sm);
}

.mp-note {
  width: 100%;
  min-height: 96rpx;
  font-size: var(--font-md);
  line-height: 1.5;
  color: var(--ink);
}

.mp-note__ph {
  color: var(--muted);
}

.mp-count {
  margin-top: 8rpx;
  text-align: right;
  font-size: var(--font-xs);
  color: var(--muted);
}

.mp-confirm {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 96rpx;
  margin-top: 32rpx;
  background-color: var(--accent-strong);
  border: 3rpx dashed var(--line);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-btn);
  color: var(--card);
  font-size: 30rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  transition: transform 150ms linear;
}

.mp-confirm:active {
  transform: translate(3rpx, 3rpx);
  box-shadow: none;
}

.mp-confirm.is-disabled {
  opacity: 0.5;
  box-shadow: none;
}
