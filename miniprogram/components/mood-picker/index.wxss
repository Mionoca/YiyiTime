.mp-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 60;
  display: flex;
  align-items: flex-end;
  background: rgba(63, 58, 54, 0.32);
}

.mp-sheet {
  width: 100%;
  padding: 24rpx 48rpx calc(48rpx + env(safe-area-inset-bottom));
  border-radius: 32rpx 32rpx 0 0;
  background: var(--card, #FFFDF9);
  color: var(--ink, #3F3A36);
  animation: mp-up 240ms ease-out;
}

@keyframes mp-up {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.mp-handle {
  width: 64rpx;
  height: 8rpx;
  margin: 0 auto 24rpx;
  border-radius: 999rpx;
  background: var(--wall, #F3E8D8);
}

.mp-title {
  font-size: 34rpx;
  font-weight: 600;
}

.mp-sub {
  margin-top: 6rpx;
  font-size: var(--font-sm, 24rpx);
  color: var(--muted, #8C837A);
}

.mp-options {
  display: flex;
  justify-content: space-between;
  margin: 32rpx 0 8rpx;
}

.mp-option {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 140rpx;
  height: 150rpx;
  border-radius: 24rpx;
  border: 2rpx solid transparent;
  background: var(--bg, #FBF6EE);
  transition: transform 160ms ease, border-color 160ms ease;
}

.mp-option.is-active {
  border-color: var(--accent, #D98E73);
  background: var(--accent-soft, #F4C9B8);
  transform: translateY(-4rpx);
}

.mp-option__icon {
  font-size: 44rpx;
  line-height: 1.2;
}

.mp-option__label {
  margin-top: 8rpx;
  font-size: var(--font-sm, 24rpx);
  color: var(--ink, #3F3A36);
}

.mp-note-wrap {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: var(--bg, #FBF6EE);
}

.mp-note {
  width: 100%;
  min-height: 96rpx;
  font-size: var(--font-md, 28rpx);
  line-height: 1.5;
  color: var(--ink, #3F3A36);
}

.mp-note__ph {
  color: var(--ink-faint, #C4B9AC);
}

.mp-count {
  margin-top: 8rpx;
  text-align: right;
  font-size: var(--font-xs, 22rpx);
  color: var(--ink-faint, #C4B9AC);
}

.mp-confirm {
  margin-top: 32rpx;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  border-radius: 48rpx;
  background: var(--accent, #D98E73);
  color: #FFFFFF;
  font-size: 30rpx;
  letter-spacing: 2rpx;
}

.mp-confirm.is-disabled {
  opacity: 0.5;
}
