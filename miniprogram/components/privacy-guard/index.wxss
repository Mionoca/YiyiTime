/* 隐私授权弹窗：涂鸦风（文档 8.7 / 13.8） */
.privacy {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  /* 文档 9.8：必须盖住所有页面浮层 */
  z-index: 200;
}

.privacy__mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background-color: rgba(44, 44, 44, 0.42);
}

.privacy__card {
  position: absolute;
  left: 40rpx;
  right: 40rpx;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  padding: 40rpx 40rpx 32rpx;
  background-color: var(--card);
  border: 3rpx dashed var(--line);
  border-radius: var(--radius-md);
  box-shadow: 10rpx 10rpx 0 var(--marker-yellow);
}

.privacy__title {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--ink);
  transform: rotate(-2deg);
}

.privacy__text {
  margin-top: 16rpx;
  font-size: var(--font-sm);
  color: var(--muted);
  line-height: 1.6;
}

.privacy__item {
  margin-top: 10rpx;
  font-size: var(--font-sm);
  color: var(--ink);
  line-height: 1.6;
}

.privacy__link {
  display: inline-block;
  min-height: 88rpx;
  line-height: 88rpx;
  margin-top: 8rpx;
  font-size: var(--font-sm);
  color: var(--accent-ink);
  border-bottom: 2rpx dashed var(--accent-ink);
}

/* 同意：墨黑实心 + 虚线边 + 马克笔红硬阴影 */
.privacy__agree {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 96rpx;
  margin-top: 24rpx;
  padding: 0 48rpx;
  background-color: var(--accent-strong);
  border: 3rpx dashed var(--line);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-btn);
  color: var(--card);
  font-size: 30rpx;
  font-weight: 800;
  transition: transform 150ms linear;
}

.privacy__agree:active {
  transform: translate(3rpx, 3rpx);
  box-shadow: none;
}

.privacy__agree::after {
  border: none;
}

.privacy__skip {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  margin-top: 8rpx;
  font-size: var(--font-sm);
  color: var(--muted);
}
