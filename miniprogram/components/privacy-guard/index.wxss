.privacy {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  /* 文档 9.8：页面级浮层第 6 层之上（隐私弹窗必须盖住所有浮层） */
  z-index: 200;
}

.privacy__mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(63, 58, 54, 0.42);
}

.privacy__card {
  position: absolute;
  left: 48rpx;
  right: 48rpx;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  padding: 40rpx 40rpx 32rpx;
  border-radius: var(--radius-lg, 32rpx);
  background: var(--card, #FFFDF9);
  box-shadow: 0 16rpx 48rpx rgba(63, 58, 54, 0.24);
}

.privacy__title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--ink, #3F3A36);
}

.privacy__text {
  margin-top: 16rpx;
  font-size: var(--font-sm, 24rpx);
  color: var(--muted, #8C837A);
  line-height: 1.6;
}

.privacy__item {
  margin-top: 10rpx;
  font-size: var(--font-sm, 24rpx);
  color: var(--ink, #3F3A36);
  line-height: 1.6;
}

.privacy__link {
  margin-top: 24rpx;
  font-size: var(--font-sm, 24rpx);
  color: var(--accent-ink, #8A5A45);
  text-decoration: underline;
}

.privacy__agree {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  margin-top: 32rpx;
  padding: 0 48rpx;
  border-radius: 48rpx;
  background-color: var(--accent-strong, #A85C42);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 500;
}

.privacy__agree::after {
  border: none;
}

.privacy__skip {
  margin-top: 20rpx;
  text-align: center;
  font-size: var(--font-sm, 24rpx);
  color: var(--muted, #8C837A);
  /* 文档 8.9：可点文字热区 ≥88rpx */
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
