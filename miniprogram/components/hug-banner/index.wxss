/*
 * 抱抱横幅：涂鸦风（文档 8.7）。
 * 首页 M8 起用抱抱卡替代了横幅，组件保留给后续页面复用；
 * 这里同步去掉渐变，避免与「不用渐变」的规范冲突。
 */
.hb {
  display: flex;
  align-items: center;
  padding: 18rpx 24rpx;
  background-color: var(--card);
  border: 3rpx dashed var(--line);
  border-radius: var(--radius-md);
  box-shadow: 6rpx 6rpx 0 var(--marker-red);
}

.hb--incoming {
  background-color: var(--accent-soft);
}

.hb__heart {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: 50%;
  border: 2rpx dashed var(--line);
  background-color: var(--card);
  color: var(--marker-red);
  font-size: 28rpx;
}

.hb__body {
  flex: 1;
  min-width: 0;
  padding: 0 18rpx;
}

.hb__text {
  font-size: var(--font-sm);
  color: var(--ink);
  line-height: 1.4;
}

.hb__btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 28rpx;
  background-color: var(--accent-strong);
  border: 3rpx dashed var(--line);
  border-radius: var(--radius-md);
  color: var(--card);
  font-size: var(--font-sm);
  font-weight: 800;
}
