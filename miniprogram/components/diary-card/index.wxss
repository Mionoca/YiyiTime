/* 手帐日记卡（文档 8.7 / 8.7.1）：纸纹底 + 虚线边 + 彩影，正文用楷体栈 */
.dc {
  position: relative;
  margin-bottom: 28rpx;
  padding: 32rpx 30rpx 26rpx;
  background-color: var(--card);
  background-image: url('../../images/paper-fiber.png');
  background-repeat: repeat;
  border: 3rpx dashed var(--line);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
}

/* 今天的日记：换成马克笔红硬阴影，一眼能认出（贴纸只在今天这张，同屏 ≤3 个） */
.dc--today {
  box-shadow: 8rpx 8rpx 0 var(--marker-red);
}

/* 装饰胶带：半透明黄、轻微旋转，永远不吃点击 */
.dc__tape {
  position: absolute;
  top: -14rpx;
  left: 36rpx;
  width: 96rpx;
  height: 26rpx;
  background-color: rgba(255, 217, 61, 0.7);
  border-left: 2rpx dashed rgba(44, 44, 44, 0.35);
  border-right: 2rpx dashed rgba(44, 44, 44, 0.35);
  transform: rotate(-4deg);
  pointer-events: none;
}

/* 日记解锁微光：opacity + 轻微上移，400ms 一次（文档 9.7） */
.dc--glow {
  animation: dc-unlock 400ms linear;
}

@keyframes dc-unlock {
  0% {
    opacity: 0.35;
    transform: translateY(10rpx);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

.dc__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
  padding-bottom: 12rpx;
  border-bottom: 2rpx dashed var(--ink-faint);
}

.dc__date {
  font-family: var(--font-hand);
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
  letter-spacing: 2rpx;
}

.dc--today .dc__date {
  color: var(--accent-ink);
}

.dc__marks {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

/* 可见性标签：方角小标签，文字说清是「给他看」还是「仅自己」 */
.dc__share,
.dc__privacy {
  padding: 2rpx 12rpx;
  border: 2rpx dashed var(--line);
  border-radius: var(--radius-sm);
  font-size: var(--font-xs);
  font-weight: 700;
  color: var(--ink);
}

.dc__share {
  background-color: var(--accent-soft);
  border-color: var(--accent-ink);
  color: var(--accent-ink);
}

.dc__privacy {
  background-color: transparent;
  color: var(--muted);
}

.dc__lock {
  font-size: var(--font-sm);
}

.dc__block {
  padding: 14rpx 0;
}

.dc__block--partner {
  border-top: 2rpx dashed var(--ink-faint);
}

.dc__who {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 10rpx;
}

/* 名字标签：小方角 + 虚线边，不用胶囊（8.7） */
.dc__tag {
  padding: 2rpx 14rpx;
  background-color: var(--accent-soft);
  border: 2rpx dashed var(--accent-ink);
  border-radius: var(--radius-sm);
  color: var(--accent-ink);
  font-size: var(--font-xs);
  font-weight: 700;
}

.dc__tag--partner {
  background-color: var(--wall);
  border-color: var(--line);
  color: var(--muted);
}

.dc__time {
  font-size: var(--font-xs);
  color: var(--muted);
}

/* 分值角标：数字 + 文字都在，颜色只做底（8.9） */
.dc__mood {
  padding: 2rpx 12rpx;
  border: 2rpx dashed var(--ink);
  border-radius: var(--radius-sm);
  font-size: var(--font-xs);
  font-weight: 700;
  color: var(--ink);
}

.dc__text {
  font-family: var(--font-hand);
  font-size: 30rpx;
  color: var(--ink);
  line-height: 1.8;
  word-break: break-all;
  white-space: pre-wrap;
}

.dc__empty {
  font-size: var(--font-md);
  color: var(--muted);
}

.dc__locktext {
  font-size: var(--font-md);
  color: var(--muted);
  line-height: 1.6;
}

/* 配图：一行最多三张，方角、虚线边，与纸同色底 */
.dc__pics {
  display: flex;
  gap: 12rpx;
  margin-top: 14rpx;
}

.dc__pic {
  width: 180rpx;
  height: 180rpx;
  background-color: var(--wall);
  border: 2rpx dashed var(--ink-faint);
  border-radius: var(--radius-sm);
}
