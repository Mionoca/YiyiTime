/* 空态：涂鸦风（文档 8.7 / 8.9） */
.es {
  padding: 96rpx 48rpx;
  text-align: center;
}

.es__icon {
  font-size: 64rpx;
  line-height: 1.2;
}

.es__title {
  margin-top: 16rpx;
  font-size: var(--font-md);
  color: var(--muted);
  line-height: 1.6;
}

.es__desc {
  margin-top: 12rpx;
  font-size: var(--font-sm);
  color: var(--muted);
  line-height: 1.6;
}

/* 重试/行动按钮：奶白底 + 虚线墨边 + 硬阴影，热区 ≥88rpx */
.es__action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  margin-top: 40rpx;
  padding: 0 48rpx;
  background-color: var(--card);
  border: 3rpx dashed var(--line);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-btn);
  color: var(--ink);
  font-size: var(--font-sm);
  font-weight: 800;
  letter-spacing: 2rpx;
  transition: transform 150ms linear;
}

.es__action:active {
  transform: translate(3rpx, 3rpx);
  box-shadow: none;
}
