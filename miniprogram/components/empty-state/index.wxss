.es {
  padding: 96rpx 48rpx;
  text-align: center;
}

.es__icon {
  font-size: 64rpx;
  line-height: 1.2;
}

.es__title {
  margin-top: 16rpx;
  font-size: var(--font-md, 28rpx);
  color: var(--muted, #8C837A);
  line-height: 1.6;
}

.es__desc {
  margin-top: 12rpx;
  font-size: var(--font-sm, 24rpx);
  color: var(--muted, #6F685F);
  line-height: 1.6;
}

.es__action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  margin-top: 40rpx;
  padding: 0 56rpx;
  border-radius: 999rpx;
  background: var(--accent-strong, #A85C42);
  color: #FFFFFF;
  font-size: var(--font-sm, 24rpx);
  letter-spacing: 2rpx;
}
